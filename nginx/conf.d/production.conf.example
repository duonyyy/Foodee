# ==============================================================================
# Foodee Platform — Production Domain & SSL Template (Let's Encrypt / Subdomains)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Đổi tên file này thành `production.conf` (hoặc copy nội dung vào file .conf mới)
# 2. Thay thế `foodee.vn` bằng tên miền thực tế của bạn
# 3. Tạo chứng chỉ SSL bằng Certbot hoặc đặt chứng chỉ vào thư mục `/etc/nginx/ssl`
# 4. Chạy `nginx -t` để kiểm tra cú pháp và `nginx -s reload` để áp dụng
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP to HTTPS Redirection + ACME Webroot (Certbot)
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name foodee.vn www.foodee.vn api.foodee.vn ai.foodee.vn storage.foodee.vn;

    # Let's Encrypt ACME challenge verification path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirect all HTTP requests to HTTPS with 301 Moved Permanently
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. Frontend Web Client (foodee.vn & www.foodee.vn)
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name foodee.vn www.foodee.vn;

    # SSL Certificates
    ssl_certificate /etc/letsencrypt/live/foodee.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/foodee.vn/privkey.pem;

    # Modern TLS Security Parameters
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # HSTS (HTTP Strict Transport Security)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Next.js Static Cache
    location /_next/static/ {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location /_next/image {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        expires 7d;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400";
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# ------------------------------------------------------------------------------
# 3. Core API (api.foodee.vn)
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.foodee.vn;

    ssl_certificate /etc/letsencrypt/live/foodee.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/foodee.vn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location = /healthz {
        access_log off;
        return 200 "OK\n";
    }

    # GraphQL & WebSocket subscriptions
    location /graphql {
        proxy_pass http://api_upstream/graphql;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Auth brute-force protection
    location /auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # General API Routes
    location / {
        limit_req zone=api_limit burst=50 nodelay;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

# ------------------------------------------------------------------------------
# 4. Object Storage (storage.foodee.vn)
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name storage.foodee.vn;

    ssl_certificate /etc/letsencrypt/live/foodee.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/foodee.vn/privkey.pem;

    client_max_body_size 50M;

    location / {
        proxy_pass http://minio_s3_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
