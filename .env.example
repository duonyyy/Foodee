# ==============================================================================
# Foodee Platform - Unified Environment Configuration Template
# ==============================================================================
# Copy this file to .env at the root directory:
#   cp .env.example .env

# --- Global & Ports ---
NODE_ENV=production
FRONTEND_PORT=3000
PORT=3001
FOOD_AI_PORT=5000
AI_SERVER_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Service Hostnames (Docker Network) ---
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
AI_SERVER_URL=http://ai-server:8000
FOOD_AI_URL=http://food-ai:5000

# --- PostgreSQL Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_NAME=foodee_db
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000

# --- Redis Cache & Messaging ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO Object Storage ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=miniouser
MINIO_SECRET_KEY=miniopassword
MINIO_BUCKET=foodee
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- Core API Authentication ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=3600s

# --- Frontend (Public Environment Variables) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FOOD_AI_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_CLIENT_ID=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Chatbot AI Service ---
# Generate one random value and set it in both core-api/.env and chatbot-service/.env.
AI_SERVICE_TOKEN=
LLM_PROVIDER=local
CHAT_LLM_BASE_URL=http://host.docker.internal:1234/v1
CHAT_LLM_MODEL=qwen/qwen2.5-vl-7b
CHAT_LLM_TEMPERATURE=0.3
CHAT_LLM_TIMEOUT_MS=8000
AI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Vision AI Service ---
FOOD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FOOD_DETECTION_CONFIDENCE=0.1
FOOD_DETECTION_IOU=0.35
FOOD_CLASSIFICATION_CONFIDENCE=0.5
