# Pick one provider. Do not commit the real .env file.
AI_SERVICE_TOKEN=
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Docker Desktop: this reaches LM Studio/vLLM on the Windows host.
CHAT_LLM_BASE_URL=http://host.docker.internal:1234/v1
CHAT_LLM_MODEL=qwen/qwen2.5-vl-7b
CHAT_LLM_TEMPERATURE=0.3
CHAT_LLM_TIMEOUT_MS=8000

# Required only when exposing the service outside the Docker network for debugging.
AI_ALLOWED_ORIGINS=http://localhost:3001
