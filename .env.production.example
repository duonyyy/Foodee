# Copy to .env.production on the Linux deployment host. chmod 600 the copy.
# This example must never be used as a real secret file.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
STORAGE_DOMAIN=storage.example.com
GHCR_NAMESPACE=your-github-owner
IMAGE_TAG=sha-0000000

DB_USERNAME=foodee
DB_NAME=foodee
DB_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
MINIO_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
MINIO_BUCKET=foodee
AI_SERVICE_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS

# gemini requires GEMINI_API_KEY. local requires a reachable CHAT_LLM_BASE_URL.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
CHAT_LLM_BASE_URL=
CHAT_LLM_MODEL=

# The current API initializes Mapbox, MoMo, and VNPay during startup.
# All production credentials and live provider endpoints are therefore required.
MAPBOX_ACCESS_TOKEN=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=
VNPAY_API_URL=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=

# Firebase social login requires the service account values as well.
# Keep the private key in this chmod-600 file only if this login flow is enabled.
