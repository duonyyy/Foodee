# Browser-visible endpoints. These values are compiled at frontend build time.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FOOD_AI_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_CLIENT_ID=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Server-only MinIO connection. Use the same bucket and credentials as core-api.
INTERNAL_API_URL=http://localhost:3001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=foodee
# Browser-visible object URL; set to the public HTTPS storage domain in production.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
